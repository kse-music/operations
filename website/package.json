{
  "name": "@serverdeck/website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:site": "vite --host 127.0.0.1 --port 4180 --strictPort",
    "dev:docs": "vitepress dev documentation --host 127.0.0.1 --port 4181 --strictPort",
    "preview": "vite preview --host 127.0.0.1 --port 4180 --strictPort",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && npm run build:site && npm run build:docs && node scripts/assemble.mjs && npm run docs:check",
    "build:site": "vite build && vite build --ssr src/entry-server.ts --outDir .ssr && node scripts/prerender.mjs",
    "build:docs": "vitepress build documentation",
    "docs:check": "node scripts/check-docs.mjs",
    "docs:import": "node scripts/import-plugin-docs.mjs",
    "test": "node --test scripts/documentation.test.mjs scripts/search-index.test.mjs scripts/marketplace.test.mjs"
  },
  "dependencies": {
    "@lucide/vue": "1.66.0",
    "@vue/server-renderer": "3.5.44",
    "@vueuse/core": "12.8.2",
    "minisearch": "7.2.0",
    "vue": "3.5.44"
  },
  "overrides": {
    "vitepress": {
      "vite": "6.4.6"
    }
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.10",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitepress": "1.6.4",
    "vue-tsc": "3.3.14"
  }
}
