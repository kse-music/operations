{
  "name": "@serverdeck/website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4180 --strictPort",
    "preview": "vite preview --host 127.0.0.1 --port 4180 --strictPort",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build && vite build --ssr src/entry-server.ts --outDir .ssr && node scripts/prerender.mjs",
    "test": "node --test scripts/release.test.mjs",
    "release:sync": "node scripts/sync-release.mjs"
  },
  "dependencies": {
    "@lucide/vue": "1.66.0",
    "@vue/server-renderer": "3.5.44",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.10",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vue-tsc": "3.3.14"
  }
}
