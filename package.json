{
  "name": "serverdeck",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/desktop",
    "packages/plugin-sdk"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "plugins:fetch": "node tools/build-system-plugins.mjs --fetch-only --with-test-fixtures",
    "plugins:build": "node tools/build-system-plugins.mjs --with-test-fixtures",
    "dev": "npm run dev -w @serverdeck/desktop",
    "build": "npm run build -w @serverdeck/desktop",
    "typecheck": "npm run typecheck -w @serverdeck/desktop && npm run typecheck -w @serverdeck/plugin-sdk",
    "test": "npm run test -w @serverdeck/desktop",
    "test:build": "node --test tools/build-space.test.mjs tools/system-plugins.test.mjs tools/app-version.test.mjs",
    "test:native": "node tools/native-e2e.mjs",
    "test:terminal": "node tools/native-terminal-e2e.mjs",
    "test:terminal-latency": "node tools/native-terminal-latency.mjs --verify",
    "lint": "eslint apps/desktop/src apps/desktop/vite.config.ts packages/plugin-sdk/src plugins/system tests/fixtures/plugins/custom-ui/frontend tests/fixtures/plugins/host-info/frontend --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tauri": "node tools/tauri.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.56.0",
    "@eslint/js": "^10.0.0",
    "@types/node": "22.20.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-vue": "^10.5.0",
    "fflate": "0.8.3",
    "globals": "^17.0.0",
    "prettier": "^3.6.0",
    "typescript-eslint": "^8.46.0",
    "vue-eslint-parser": "^10.2.0"
  },
  "overrides": {
    "dompurify": "^3.4.17",
    "minimatch": "^11.0.1"
  }
}
