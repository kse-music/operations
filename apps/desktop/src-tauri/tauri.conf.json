{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ServerDeck",
  "identifier": "cn.hiboot.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "ServerDeck",
        "decorations": false,
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "backgroundColor": "#101217"
      }
    ],
    "security": {
      "capabilities": ["main", "remote-editor"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'; frame-src sdplugin: http://sdplugin.localhost",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; object-src 'none'; base-uri 'self'; form-action 'none'; frame-src sdplugin: http://sdplugin.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "ServerDeck",
    "category": "DeveloperTool",
    "shortDescription": "Local-first agentless Linux operations workspace",
    "longDescription": "SSH terminals, SFTP, monitoring and explicitly confirmed Linux operations.",
    "copyright": "Copyright 2026 ServerDeck contributors",
    "license": "MIT",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "startMenuFolder": "ServerDeck"
      }
    },
    "resources": {
      "../../../LICENSE": "LICENSE",
      "../../../docs/release/THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt",
      "../../../docs/release/DEPENDENCY_INVENTORY.md": "DEPENDENCY_INVENTORY.md"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFFNjJBMzQyMjI5MTBBRjkKUldUNUNwRWlRcU5pcnB6UnAwYWMvdy9LWHY1cGhCZkNPOElaNGMzT2tJZDhNNGRwNjlES0dIU0wK",
      "endpoints": ["https://github.com/kse-music/operations/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  }
}
