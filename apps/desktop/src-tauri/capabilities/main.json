    "allow-transfer-retry",
    "allow-text-read",
    "allow-text-save",
    "allow-text-dirty",
    "allow-text-close",
    "allow-file-terminal",
    "allow-app-exit-confirm",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-workspace-load",
    "allow-workspace-save",
    "allow-forward-start",
    "allow-forward-list",
    "allow-forward-stop",
