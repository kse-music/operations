{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@serverdeck/plugin-sdk/*": ["../../packages/plugin-sdk/src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "vite.config.ts",
    "../../packages/plugin-sdk/src/**/*.ts",
    "../../packages/plugin-sdk/src/**/*.vue",
    "../../plugins/system/**/*.ts",
    "../../plugins/system/**/*.vue",
    "../../plugins/compat/**/*.ts",
    "../../plugins/compat/**/*.vue"
  ]
}
