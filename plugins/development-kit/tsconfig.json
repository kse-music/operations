{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "example/frontend/**/*.ts",
    "example/frontend/**/*.vue",
    "packages/plugin-sdk/src/**/*.ts",
    "packages/plugin-sdk/src/**/*.vue"
  ]
}
