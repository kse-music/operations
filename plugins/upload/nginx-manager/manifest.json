{
  "schemaVersion": 1,
  "id": "dev.serverdeck.nginx-manager",
  "name": "Nginx Manager",
  "version": "1.0.0",
  "author": "ServerDeck",
  "description": "Manage authorized Linux Nginx configuration, syntax validation, explicit reload and logs through the public SDK",
  "apiVersion": "^1.0.0",
  "entry": {
    "backend": "backend.wasm",
    "ui": "ui.json"
  },
  "permissions": ["hosts.read", "ssh.execute", "sftp.read", "sftp.write", "ui.contribute"],
  "contributions": [
    {
      "id": "nginx",
      "kind": "workspace",
      "label": "Nginx Manager"
    },
    {
      "id": "navigation",
      "kind": "navigation",
      "label": "Nginx Manager"
    },
    {
      "id": "menu",
      "kind": "host_menu",
      "label": "Nginx Manager"
    },
    {
      "id": "command",
      "kind": "command",
      "label": "Nginx Manager"
    }
  ],
  "platforms": ["windows", "linux", "macos"],
  "files": [],
  "publisher": null
}
